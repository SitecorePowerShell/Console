###################################
# Project
###################################
REGISTRY=
COMPOSE_PROJECT_NAME=spe

###################################
# Sitecore image registry & versions
###################################
SITECORE_DOCKER_REGISTRY=scr.sitecore.com/sxp/
SITECORE_MODULE_REGISTRY=scr.sitecore.com/sxp/modules/
SITECORE_TOOLS_REGISTRY=scr.sitecore.com/tools/
SITECORE_VERSION=10.5-ltsc2022
SITECORE_ID_VERSION=9.0-ltsc2022
EXTERNAL_IMAGE_TAG_SUFFIX=ltsc2022
MANAGEMENT_SERVICES_VERSION=5.2.123-ltsc2022

###################################
# SQL Server
###################################
SQL_SERVER=mssql
SQL_SA_LOGIN=sa
# Generated by init.ps1.
SQL_SA_PASSWORD=
# There is no SQL TLS certificate in this dev stack. The mssql image registers a
# mounted PFX without persisting its private key, which breaks the TLS handshake,
# so SQL serves its own self-generated certificate and clients pass
# TrustServerCertificate=true. See the mssql service in docker-compose.yml.
# Set only when renaming an existing database set; leave empty for a fresh deployment.
SQL_CUSTOM_DATABASE_PREFIX_UPDATE_FROM=

###################################
# Sitecore platform
###################################
SQL_DATABASE_PREFIX=Sitecore
# Generated by init.ps1.
SITECORE_ADMIN_PASSWORD=
LOG_LEVEL_VALUE=INFO

###################################
# Solr
###################################
SOLR_CORE_PREFIX_NAME=sitecore
SOLR_ADMIN_USERNAME=admin
# Generated by init.ps1.
SOLR_ADMIN_PASSWORD=
# SOLR_CONNECTION_USERNAME is created per deployment; keep it aligned with SOLR_CORE_PREFIX_NAME.
SOLR_CONNECTION_USERNAME=sitecore
# Generated by init.ps1.
SOLR_CONNECTION_PASSWORD=

###################################
# Secrets (generated by init.ps1)
###################################
TELERIK_ENCRYPTION_KEY=
SITECORE_IDSECRET=
SITECORE_ID_CERTIFICATE=
SITECORE_ID_CERTIFICATE_PASSWORD=
MEDIA_REQUEST_PROTECTION_SHARED_SECRET=
# gzip + base64 of license.xml; Sitecore 10.5 takes the license by value, not by volume mount.
SITECORE_LICENSE=

###################################
# Hosts & networking
###################################
CM_HOST=spe.dev.local
ID_HOST=speid.dev.local
TRAEFIK_IMAGE=traefik:v3.7.5-windowsservercore-ltsc2022
TRAEFIK_ISOLATION=process
ISOLATION=process

###################################
# SPE module
###################################
SPE_ADMIN_PAGE_ENABLED=true
# Generated by init.ps1.
SPE_SHARED_SECRET=
# Generated by init.ps1; consumed by the IDS spe-remoting client.
SPE_OAUTH_CLIENT_SECRET=
# OAuth bearer auth is activated by copying Spe.OAuthBearer.config.example
# to Spe.OAuthBearer.config (drop the .example suffix), then redeploy.
